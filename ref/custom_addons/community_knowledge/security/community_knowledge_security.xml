<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_community_knowledge" model="res.groups.privilege">
        <field name="name">Knowledge</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_community_knowledge_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_community_knowledge"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_community_knowledge_article_user_read" model="ir.rule">
        <field name="name">Knowledge articles: read visible articles</field>
        <field name="model_id" ref="model_community_knowledge_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', '|', ('access_mode', '=', 'internal'), ('owner_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_community_knowledge_article_user_write" model="ir.rule">
        <field name="name">Knowledge articles: edit writable articles</field>
        <field name="model_id" ref="model_community_knowledge_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', '|', ('access_mode', '=', 'internal'), ('owner_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_community_knowledge_article_user_unlink" model="ir.rule">
        <field name="name">Knowledge articles: delete owned or editable private articles</field>
        <field name="model_id" ref="model_community_knowledge_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_community_knowledge_article_manager_all" model="ir.rule">
        <field name="name">Knowledge administrators: all articles</field>
        <field name="model_id" ref="model_community_knowledge_article"/>
        <field name="groups" eval="[(4, ref('group_community_knowledge_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
