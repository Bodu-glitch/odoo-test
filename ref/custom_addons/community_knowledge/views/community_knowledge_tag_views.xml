<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="community_knowledge_tag_view_list" model="ir.ui.view">
        <field name="name">community.knowledge.tag.view.list</field>
        <field name="model">community.knowledge.tag</field>
        <field name="arch" type="xml">
            <list string="Knowledge Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="community_knowledge_tag_view_form" model="ir.ui.view">
        <field name="name">community.knowledge.tag.view.form</field>
        <field name="model">community.knowledge.tag</field>
        <field name="arch" type="xml">
            <form string="Knowledge Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_community_knowledge_tags" model="ir.actions.act_window">
        <field name="name">Knowledge Tags</field>
        <field name="res_model">community.knowledge.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
