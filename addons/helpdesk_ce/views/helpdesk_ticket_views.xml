<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_helpdesk_kanban"
                    group_create="false" quick_create="true"
                    quick_create_view="helpdesk_ce.helpdesk_ticket_view_quick_create">
                <field name="color"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="tag_ids"/>
                <field name="kanban_state"/>
                <field name="sla_deadline"/>
                <field name="sla_fail"/>
                <field name="ticket_ref"/>
                <progressbar field="kanban_state"
                             colors='{"normal": "muted", "done": "success", "blocked": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_color_#{record.color.value}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title o_text_overflow">
                                        <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id"/>
                                    </span>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                                <t t-if="record.sla_deadline.value">
                                    <span t-attf-class="badge #{record.sla_fail.value ? 'text-bg-danger' : 'text-bg-secondary'} mt-1"
                                          title="SLA Deadline">
                                        <i class="fa fa-clock-o me-1"/>
                                        <field name="sla_deadline" widget="date"/>
                                    </span>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                         t-att-title="record.user_id.value"
                                         t-att-alt="record.user_id.value"
                                         class="oe_kanban_avatar o_image_24_cover rounded-circle"
                                         t-if="record.user_id.raw_value"/>
                                    <field name="kanban_state" widget="kanban_state_selection"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Quick create form -->
    <record id="helpdesk_ticket_view_quick_create" model="ir.ui.view">
        <field name="name">helpdesk.ticket.quick.create</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="name" placeholder="Ticket Subject"/>
                <field name="partner_id" placeholder="Customer"/>
                <field name="user_id" placeholder="Assigned to"
                       domain="[('share', '=', False)]"/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <tree string="Tickets" multi_edit="1">
                <field name="ticket_ref" string="ID" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="name" string="Name"/>
                <field name="user_id" widget="many2one_avatar_user" string="Assigned to" optional="show"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="sla_deadline" string="SLA Deadline" optional="show"/>
                <field name="stage_id" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"
                           domain="[('team_ids', 'in', team_id)]"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ticket Subject..."/>
                        </h1>
                        <div>
                            <field name="ticket_ref" class="text-muted" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_phone" widget="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add details about this ticket..."/>
                        </page>
                        <page string="SLA Status" name="sla_status"
                              invisible="not sla_status_ids">
                            <field name="sla_status_ids" readonly="1">
                                <tree>
                                    <field name="sla_id"/>
                                    <field name="deadline"/>
                                    <field name="reached_datetime"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'reached'"
                                           decoration-danger="status == 'failed'"
                                           decoration-info="status == 'in_progress'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name" string="Subject" filter_domain="['|', ('name','ilike',self), ('ticket_ref','ilike',self)]"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id" string="Assigned to"/>
                <field name="team_id" string="Team"/>
                <field name="tag_ids" string="Tags"/>
                <separator/>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id','=',uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id','=',False)]"/>
                <filter name="open" string="Open" domain="[('stage_id.is_close','=',False)]"/>
                <filter name="closed" string="Closed" domain="[('stage_id.is_close','=',True)]"/>
                <filter name="urgent" string="Urgent" domain="[('priority','=','3')]"/>
                <filter name="high_priority" string="High Priority" domain="[('priority','in',['2','3'])]"/>
                <filter name="sla_failed" string="SLA Failed" domain="[('sla_fail','=',True)]"/>
                <separator/>
                <filter name="active_test" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_user" string="Assigned to" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_helpdesk_ticket_team" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ticket!
            </p>
        </field>
    </record>

    <record id="action_helpdesk_my_tickets" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_tickets': 1, 'search_default_open': 1}</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
    </record>

    <record id="action_helpdesk_all_tickets" model="ir.actions.act_window">
        <field name="name">All Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
    </record>
</odoo>


