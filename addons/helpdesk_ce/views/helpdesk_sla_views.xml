<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_sla_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <tree string="SLA Policies">
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority" widget="priority"/>
                <field name="stage_id" string="Reach Stage"/>
                <field name="time" string="Within (hours)"/>
            </tree>
        </field>
    </record>

    <record id="helpdesk_sla_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Close urgent tickets within 36 hours"/>
                        </h1>
                    </div>
                    <field name="description" placeholder="Description of the policy..."/>

                    <separator string="CRITERIA"/>
                    <p class="text-muted">This SLA Policy will apply to tickets matching ALL of the following criteria:</p>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags" string="Customers"/>
                        </group>
                    </group>

                    <separator string="TARGET"/>
                    <group>
                        <group>
                            <field name="stage_id" string="Reach Stage"/>
                            <label for="time" string="Within"/>
                            <div class="o_row">
                                <field name="time" class="oe_inline" widget="float_time"/>
                                <span>Working Hours</span>
                            </div>
                        </group>
                        <group>
                            <field name="exclude_stage_ids" widget="many2many_tags" string="Excluding Stages"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

