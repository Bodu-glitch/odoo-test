<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overview client action -->
    <record id="action_helpdesk_overview" model="ir.actions.client">
        <field name="name">Helpdesk Overview</field>
        <field name="tag">helpdesk_ce.overview</field>
    </record>

    <!-- Tickets Analysis (graph) -->
    <record id="action_helpdesk_tickets_analysis" model="ir.actions.act_window">
        <field name="name">Tickets Analysis</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_team': 1}</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
    </record>

    <!-- SLA Status Analysis -->
    <record id="action_helpdesk_sla_analysis" model="ir.actions.act_window">
        <field name="name">SLA Status Analysis</field>
        <field name="res_model">helpdesk.sla.status</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <!-- Helpdesk Teams action -->
    <record id="action_helpdesk_teams" model="ir.actions.act_window">
        <field name="name">Helpdesk Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- SLA Policies action -->
    <record id="action_helpdesk_sla_policies" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tags action -->
    <record id="action_helpdesk_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Stages action -->
    <record id="action_helpdesk_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root menu -->
    <menuitem id="menu_helpdesk_root"
              name="Helpdesk"
              web_icon="helpdesk_ce,static/description/icon.png"
              sequence="95"/>

    <!-- Overview -->
    <menuitem id="menu_helpdesk_overview"
              name="Overview"
              parent="menu_helpdesk_root"
              action="action_helpdesk_overview"
              sequence="1"/>

    <!-- Tickets -->
    <menuitem id="menu_helpdesk_tickets"
              name="Tickets"
              parent="menu_helpdesk_root"
              sequence="2"/>

    <menuitem id="menu_helpdesk_my_tickets"
              name="My Tickets"
              parent="menu_helpdesk_tickets"
              action="action_helpdesk_my_tickets"
              sequence="1"/>

    <menuitem id="menu_helpdesk_all_tickets"
              name="All Tickets"
              parent="menu_helpdesk_tickets"
              action="action_helpdesk_all_tickets"
              sequence="2"/>

    <!-- Reporting -->
    <menuitem id="menu_helpdesk_reporting"
              name="Reporting"
              parent="menu_helpdesk_root"
              sequence="3"/>

    <menuitem id="menu_helpdesk_tickets_analysis"
              name="Tickets Analysis"
              parent="menu_helpdesk_reporting"
              action="action_helpdesk_tickets_analysis"
              sequence="1"/>

    <menuitem id="menu_helpdesk_sla_analysis"
              name="SLA Status Analysis"
              parent="menu_helpdesk_reporting"
              action="action_helpdesk_sla_analysis"
              sequence="2"/>

    <!-- Configuration -->
    <menuitem id="menu_helpdesk_configuration"
              name="Configuration"
              parent="menu_helpdesk_root"
              sequence="4"/>

    <menuitem id="menu_helpdesk_teams"
              name="Helpdesk Teams"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_teams"
              sequence="1"
              groups="helpdesk_ce.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_sla_policies"
              name="SLA Policies"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_sla_policies"
              sequence="2"
              groups="helpdesk_ce.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_stages"
              name="Stages"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_stages"
              sequence="3"
              groups="helpdesk_ce.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_tags"
              name="Tags"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_tags"
              sequence="4"
              groups="helpdesk_ce.group_helpdesk_manager"/>
</odoo>


